# Normalize line endings on checkin; check out LF everywhere.
* text=auto eol=lf

# Explicit text types
*.R    text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf

# Binary assets (no diff/merge munging, no EOL conversion)
*.pdf  binary
*.docx binary
*.xlsx binary
*.png  binary
*.jpg  binary
